{
  "name": "dsh-image-zoom",
  "version": "1.0.0",
  "description": "Trackpad pinch zoom and native scroll panning for DSH conversation image previews, with crisp SVG scaling.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Howard0924/dsh-image-zoom.git"
  },
  "homepage": "https://github.com/Howard0924/dsh-image-zoom#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "image",
    "zoom",
    "pinch"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
